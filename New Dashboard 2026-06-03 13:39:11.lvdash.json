{
  "datasets": [
    {
      "name": "dabcab06",
      "displayName": "Top Ten Countries by Marathon Athlete Count",
      "queryLines": [
        "SELECT athlete_country, COUNT(*) as antal\n",
        "FROM marathos_catalog.marathon_gold.dim_athlete\n",
        "WHERE athlete_country NOT LIKE 'XXX'\n",
        "GROUP BY athlete_country\n",
        "ORDER BY antal DESC\n",
        "LIMIT 10"
      ],
      "catalog": "marathos_catalog",
      "schema": "marathon_gold"
    },
    {
      "name": "5af9c59f",
      "displayName": "Athlete Gender Distribution Analysis",
      "queryLines": [
        "WITH gender_counts AS (\n",
        "  SELECT\n",
        "    CASE\n",
        "      WHEN gender = 'M' THEN 'Man'\n",
        "      WHEN gender = 'F' THEN 'Kvinna'\n",
        "      ELSE 'Annat'\n",
        "    END as gender_clean,\n",
        "    COUNT(*) as antal\n",
        "  FROM\n",
        "    marathos_catalog.marathon_gold.dim_athlete\n",
        "  GROUP BY\n",
        "    gender_clean\n",
        "),\n",
        "total_count AS (\n",
        "  SELECT\n",
        "    SUM(antal) as total\n",
        "  FROM\n",
        "    gender_counts\n",
        ")\n",
        "SELECT\n",
        "  g.gender_clean,\n",
        "  g.antal,\n",
        "  g.antal * 1.0 / t.total as percentage\n",
        "FROM\n",
        "  gender_counts g CROSS JOIN total_count t"
      ],
      "catalog": "marathos_catalog",
      "schema": "marathon_gold"
    },
    {
      "name": "49b98980",
      "displayName": "Marathon Participants Counted By Event Year Summary",
      "queryLines": [
        "SELECT\n",
        "  event_year,\n",
        "  COUNT(*) as antal_deltagare\n",
        "FROM\n",
        "  silver_cleaned\n",
        "GROUP BY\n",
        "  event_year\n",
        "ORDER BY\n",
        "  event_year"
      ],
      "catalog": "marathos_catalog",
      "schema": "marathon_silver"
    }
  ],
